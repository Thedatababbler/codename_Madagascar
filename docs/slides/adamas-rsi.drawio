" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F28C28;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1010" y="848" width="8" height="26" as="geometry"/></mxCell><mxCell id="c116" value="新版本用于后面的题，又产生新数据，进入下一轮" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontStyle=0;fontColor=#1A1A2E;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="1038" y="840" width="812" height="56" as="geometry"/></mxCell><mxCell id="c117" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F28C28;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1010" y="918" width="8" height="26" as="geometry"/></mxCell><mxCell id="c118" value="递归的对象是“改进机制”本身，不是某一次的代码" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontStyle=0;fontColor=#1A1A2E;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="1038" y="910" width="812" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c159" name="为什么算RSI"><mxGraphModel page="1" pageWidth="1920" pageHeight="1080"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c120" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c121" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0170C1;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="130" as="geometry"/></mxCell><mxCell id="c122" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F28C28;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="0" y="130" width="1920" height="8" as="geometry"/></mxCell><mxCell id="c123" value="为什么算 RSI" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=50;fontStyle=1;fontColor=#FFFFFF;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="70" y="0" width="1500" height="130" as="geometry"/></mxCell><mxCell id="c124" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="0" y="1044" width="1920" height="3" as="geometry"/></mxCell><mxCell id="c125" value="AdaMAS-RSI · 编排层上的递归自我改进 · 2026-10" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;fontColor=#4A5568;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="70" y="1044" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c126" value="4 / 18" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=22;fontStyle=0;fontColor=#4A5568;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="1620" y="1044" width="240" height="34" as="geometry"/></mxCell><mxCell id="c127" value="WHY THIS COUNTS AS RSI" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=28;fontStyle=0;fontColor=#CFE3F5;fontFamily=Century Gothic;" vertex="1" parent="1"><mxGeometry x="1180" y="0" width="680" height="130" as="geometry"/></mxCell><mxCell id="c128" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F28C28;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="178" width="8" height="26" as="geometry"/></mxCell><mxCell id="c129" value="递归：这一轮改进的产出（新表格）是下一轮改进的输入（新数据）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontStyle=0;fontColor=#1A1A2E;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="98" y="170" width="832" height="98" as="geometry"/></mxCell><mxCell id="c130" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F28C28;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="8" height="26" as="geometry"/></mxCell><mxCell id="c131" value="自我：改什么、留什么，由进化 agent 提议、统计规则决定，运行期间人不逐条审批" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontStyle=0;fontColor=#1A1A2E;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="98" y="282" width="832" height="98" as="geometry"/></mxCell><mxCell id="c132" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F28C28;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="402" width="8" height="26" as="geometry"/></mxCell><mxCell id="c133" value="有界：评估器在每个循环内固定，并有外部锚点（held-out 绊线）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontStyle=0;fontColor=#1A1A2E;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="98" y="394" width="832" height="98" as="geometry"/></mxCell><mxCell id="c134" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F28C28;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="514" width="8" height="26" as="geometry"/></mxCell><mxCell id="c135" value="人的角色：开始前设定目标、阈值和边界；不参与每一轮取舍" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontStyle=0;fontColor=#1A1A2E;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="98" y="506" width="832" height="56" as="geometry"/></mxCell><mxCell id="c136" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F28C28;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="584" width="8" height="26" as="geometry"/></mxCell><mxCell id="c137" value="定位：改进对象是“编排设计”，回路在表格层面闭合；评估器在慢循环中受外部锚点约束" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontStyle=0;fontColor=#1A1A2E;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="98" y="576" width="832" height="98" as="geometry"/></mxCell><mxCell id="c138" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#