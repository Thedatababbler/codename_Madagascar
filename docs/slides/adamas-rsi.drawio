n=left;verticalAlign=middle;fontSize=22;fontStyle=0;fontColor=#4A5568;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="70" y="1044" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c559" value="12 / 18" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=22;fontStyle=0;fontColor=#4A5568;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="1620" y="1044" width="240" height="34" as="geometry"/></mxCell><mxCell id="c560" value="COMPONENT 4 · PLANNER" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=28;fontStyle=0;fontColor=#CFE3F5;fontFamily=Century Gothic;" vertex="1" parent="1"><mxGeometry x="1180" y="0" width="680" height="130" as="geometry"/></mxCell><mxCell id="c561" value="状态：只实现了错误路由，进化逻辑待实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#F28C28;strokeWidth=2;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#B55F1F;fontFamily=微软雅黑;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="70" y="165" width="760" height="60" as="geometry"/></mxCell><mxCell id="c562" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F28C28;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="257" width="8" height="24" as="geometry"/></mxCell><mxCell id="c563" value="作用：把设计文档拆成里程碑" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=26;fontStyle=0;fontColor=#1A1A2E;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="98" y="250" width="752" height="53" as="geometry"/></mxCell><mxCell id="c564" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F28C28;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="324" width="8" height="24" as="geometry"/></mxCell><mxCell id="c565" value="触发：惰性。只有“held-out 失败但没有里程碑负责”或“边界模糊”的错误累积到阈值才启动" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=26;fontStyle=0;fontColor=#1A1A2E;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="98" y="317" width="752" height="92" as="geometry"/></mxCell><mxCell id="c566" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F28C28;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="8" height="24" as="geometry"/></mxCell><mxCell id="c567" value="进化方式：先用规划审计做便宜筛选，再用整题重跑验证" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=26;fontStyle=0;fontColor=#1A1A2E;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="98" y="423" width="752" height="53" as="geometry"/></mxCell><mxCell id="c568" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F28C28;strokeColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="497" width="8" height="24" as="geometry"/></mxCell><mxCell id="c569" value="代价：规划一变，错题库的检查点失效，需要重建；按里程碑特征记的账本经验仍可用" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=26;fontStyle=0;fontColor=#1A1A2E;fontFamily=微软雅黑;" vertex="1" parent="1"><mxGeometry x="98" y="490" width="752" height="92" as="geometry"/></mxCell><mxCell id="c570" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0170C1;strokeWidth=3;align=center;verticalAlign=middle;fontSize=28;fontStyle=0;fontColor=#1A1A2E;fontFamily=微软雅黑;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="200" height="140" as="geometry"/></mxCell><mxCell id="c571" value="" style="shape=image;imageAspect=1;image=data:image/png+base64,;" vertex="1" parent="1"><mxGeometry x="970" y="314" width="60" height="60" as="geometry"/></mxCell><mxCell id="c572" value="基础契约" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=0;fontColor=#1A1A2E;fontFamily=微软雅黑;" vertex="1" parent="1"><mx