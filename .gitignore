.env
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.coverage
htmlcov/

outputs/*
!outputs/.gitkeep

# Benchmark corpora live outside version control. RealBench was once swept in
# by a `git add -A`, which put 12M lines and six LFS objects that no longer
# exist on the server into a code branch and made the branch unpushable.
data/

# Rendered result reports. Regenerate from `outputs/` with the scripts in
# `scripts/make_*_pdf.py`; the numbers in them are only meaningful next to the
# run directories, which are not in version control either.
docs/reports/
# Local backups of .env made before editing; they hold the same secrets.
.env.bak*
